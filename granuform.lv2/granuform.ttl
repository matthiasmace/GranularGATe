@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<https://mace.vibe/granuform>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Granuform" ;
    doap:license <http://opensource.org/licenses/mit> ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Entrée G"
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Entrée D"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Sortie G"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Sortie D"
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "density" ; lv2:name "Densité (grains/s)" ;
        lv2:default 18 ; lv2:minimum 1 ; lv2:maximum 64
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "size" ; lv2:name "Taille de grain (ms)" ;
        lv2:default 140 ; lv2:minimum 10 ; lv2:maximum 1000
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "jitter" ; lv2:name "Dispersion" ;
        lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "pitch" ; lv2:name "Hauteur (½ tons)" ;
        lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "mode" ; lv2:name "Stéréo indépendante (0=mono spatialisé)" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "rot_speed" ; lv2:name "Rotation (Hz)" ;
        lv2:default 0.2 ; lv2:minimum 0 ; lv2:maximum 5
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "doppler" ; lv2:name "Doppler de rotation" ;
        lv2:default 0.05 ; lv2:minimum 0 ; lv2:maximum 0.2
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "vib_rate" ; lv2:name "Vibrato (Hz)" ;
        lv2:default 5 ; lv2:minimum 0 ; lv2:maximum 12
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "vib_cents" ; lv2:name "Vibrato (cents)" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ; lv2:symbol "gli_semis" ; lv2:name "Glissando (½ tons)" ;
        lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ; lv2:symbol "gli_period" ; lv2:name "Glissando, cycle (s)" ;
        lv2:default 4 ; lv2:minimum 0.2 ; lv2:maximum 32
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ; lv2:symbol "chaos" ; lv2:name "Chaos (transposition aléatoire)" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "mix" ; lv2:name "Mix granulaire" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 4
    ] .
